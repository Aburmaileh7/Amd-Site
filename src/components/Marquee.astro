---
// A moving strip of short words (signature items, services, the area). Static and wrapped when motion is off.
const { p } = Astro.props;
const items = p.marquee?.items || [];
---
{items.length > 0 && (
  <section class="marquee" aria-label={p.marquee.label || 'أبرز ما يميّزنا'}>
    <div class="marquee__track" data-marquee>
      {[0, 1].map((copy) => (
        <ul class="marquee__row" aria-hidden={copy ? 'true' : undefined}>
          {items.map((t) => <li>{t}<span class="marquee__dot" aria-hidden="true"></span></li>)}
        </ul>
      ))}
    </div>
  </section>
)}

<style>
  .marquee { overflow: hidden; border-block: 1px solid var(--line); padding-block: clamp(14px, 2.4vw, 26px); background: var(--surface); }
  .marquee__track { display: flex; width: max-content; }
  .marquee__row { display: flex; list-style: none; margin: 0; padding: 0; }
  .marquee__row li { display: flex; align-items: center; gap: clamp(18px, 3vw, 40px); padding-inline-end: clamp(18px, 3vw, 40px);
    font-family: var(--font-d); font-weight: var(--display-weight); font-size: clamp(1.4rem, 4.4vw, 3rem); white-space: nowrap; }
  .marquee__dot { width: .35em; height: .35em; border-radius: 50%; background: var(--glow); flex: none; }
  :global(html:not(.js-motion)) .marquee__track { width: auto; flex-wrap: wrap; justify-content: center; }
  :global(html:not(.js-motion)) .marquee__row[aria-hidden] { display: none; }
  :global(html:not(.js-motion)) .marquee__row { flex-wrap: wrap; justify-content: center; }
</style>
