  "reviews": [
    {
      "author": "Abdul M.",
      "stars": 5,
      "text": "Golden Grill House in Ruwi has undergone a complete transformation, and the results are impressive…",
      "source_ref": "Ci9DQUlRQUNvZENodHljRjlvT2pkMmRWazRURFE1U2pKWk9GRmZla28zU0Y5U1EzYxAB"
    },
    {
      "author": "Hanna M.",
      "stars": 5,
      "text": "A fabulous place with great food, service and a variety of veg, non veg, chinese and indian options. The experience was most enjoyed due to the wonderful owner Mr Ashok, who was so friendly, humble and an honest man…",
      "source_ref": "Ci9DQUlRQUNvZENodHljRjlvT25CV1QyOXpUa3g0VnpCRFVVSk9TVU00V1cxMmJYYxAB"
    },
    {
      "author": "Tomsy M.",
      "stars": 5,
      "text": "Great food with excellent service. Franky and other rolls are a must-try. They have also wide choices of Chinese and Indian dishes. Ideal for family dine in the heart of Ruwi with ample parking space.",
      "source_ref": "Ci9DQUlRQUNvZENodHljRjlvT21sVVJYRXpNbUp0Wm1sUFIwTkNWblJGYjNsU1gzYxAB"
    },
    {
      "author": "Abdul M.",
      "stars": 5,
      "text": "The food and service were absolutely amazing, 100/100! Everything was fresh and delicious. Highly recommended!",
      "source_ref": "Ci9DQUlRQUNvZENodHljRjlvT25CelQxbElTbGRMV0c5aU9FTnZjMFZ1VFdwdk0zYxAB"
    }
