  "reviews": [
    {
      "author": "Rafat R.",
      "stars": 5,
      "text": "They have the best San Sebastian cheesecake ever! It tastes like heaven, and the coffee is awesome too. The seating arrangement is comfortable and the noise level is perfect for conversation. The staff are friendly, sweet, and experienced.…",
      "source_ref": "https://www.google.com/maps/place/there%C2%B0+coffee+roasters/@26.2397576,50.5740819,17z/data=!4m6!3m5!1s0x3e49af6d0c702db1:0x9c3b8501351dea0c"
    },
    {
      "author": "Shaikha E.",
      "stars": 5,
      "text": "Hands down, one of the best coffee shops in Bahrain. They have an excellent selection of beans for V60, and it’s consistently brewed to perfection every single time.…",
      "source_ref": "https://www.google.com/maps/place/there%C2%B0+coffee+roasters/@26.2397576,50.5740819,17z/data=!4m6!3m5!1s0x3e49af6d0c702db1:0x9c3b8501351dea0c"
    },
    {
      "author": "Subhan A.",
      "stars": 5,
      "text": "Amazing attention to detail with the breakfast and coffee selection. Egg Benedict was made exactly as asked and well presented. There is a good variety of dishes available. I had a hot latte which was smooth and taste great.…",
      "source_ref": "https://www.google.com/maps/place/there%C2%B0+coffee+roasters/@26.2397576,50.5740819,17z/data=!4m6!3m5!1s0x3e49af6d0c702db1:0x9c3b8501351dea0c"
    },
    {
      "author": "Khalid W.",
      "stars": 5,
      "text": "Very good spot for high quality coffee, with san sebastian cake and fantastic view.…",
      "source_ref": "https://www.google.com/maps/place/there%C2%B0+coffee+roasters/@26.2397576,50.5740819,17z/data=!4m6!3m5!1s0x3e49af6d0c702db1:0x9c3b8501351dea0c"
    }
