  "reviews": [
    {
      "author": "Bahar F.",
      "stars": 5,
      "when": "قبل 3 أشهر",
      "text": "Sourdough Café on 18 November is my absolute go-to. Every time I visit, the vibe just lifts my mood. … It’s cosy, warm, and genuinely welcoming. The staff are consistently friendly, the prices are fair, and the daily bakes are outstanding—everything tastes fresh.",
      "source_ref": "https://www.google.com/maps/place/SOURDOUGH+OMAN+(Artisan+Bakery)/@23.6024985,58.3666077,17z/data=!4m6!3m5!1s0x3e8e01a0746fa2cf:0x5cc200f246adf508!8m2!3d23.6024985!4d58.3666077!16s%2Fg%2F11l327v8x7"
    },
    {
      "author": "Safana G.",
      "stars": 5,
      "when": "قبل 3 أشهر",
      "text": "Visited Sourdough Oman in Azaiba recently and had a pleasant experience. The café has a warm, cozy atmosphere that’s perfect for a relaxed breakfast or coffee break. The prices are reasonable for an artisan bakery, and the quality is consistent.",
      "source_ref": "https://www.google.com/maps/place/SOURDOUGH+OMAN+(Artisan+Bakery)/@23.6024985,58.3666077,17z/data=!4m6!3m5!1s0x3e8e01a0746fa2cf:0x5cc200f246adf508!8m2!3d23.6024985!4d58.3666077!16s%2Fg%2F11l327v8x7"
    },
    {
      "author": "M. N.",
      "stars": 4,
      "when": "قبل أسبوعين",
      "text": "… The brioche bread though, we used it to make a dessert at home called \"Um Ali\", and WOW! That bread made ALL the difference!!!",
