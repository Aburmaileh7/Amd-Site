  "reviews": [
    {
      "author": "Peter G.",
      "stars": 5,
      "text": "What an incredible experience at Alee! My partner and I enjoyed the set menu, and every single dish was outstanding. The service was fantastic…",
      "source_ref": "r1"
    },
    {
      "author": "Rana A.",
      "stars": 5,
      "text": "Chef Rakan was an amazing host, sharing the story behind each dish and making the whole experience feel special. We thoroughly enjoyed the food and the cozy atmosphere.",
      "source_ref": "r2"
    },
    {
      "author": "Tareq N.",
      "stars": 5,
      "text": "Alee is a fresh take on traditional Middle Eastern food. The dishes keep the familiar flavors you'd expect, but each one has a modern twist…",
      "source_ref": "r4"
    },
    {
      "author": "Isma F.",
      "stars": 5,
      "text": "The food was excellent, loved the 14 courses menu!!",
      "source_ref": "r6"
    },
    {
      "author": "Shaimaa H.",
      "stars": 5,
      "text": "Amazing food and atmosphere, highly recommend the fattoush and FREEKEH ❤️",
      "source_ref": "r8"
    },
    {
      "author": "Reham K.",
      "stars": 5,
      "text": "One of the best Jordanian experience restaurants I've ever been to… Lamb skewers were scrumptious and my absolute favourite",
      "source_ref": "r9"
    }
  ],
