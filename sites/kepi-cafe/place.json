  "reviews": [
    {
      "author": "Sara M.",
      "stars": 5,
      "text": "تجربة رائعة ، مكان هادئ والموظفين ودودين",
      "source_ref": "r5"
    },
    {
      "author": "احمد ا.",
      "stars": 5,
      "text": "جيت لهم الصباح والمكان جميل جدا موقعه ركن ، فيه موظف اسمه يوسف رائع جدا وأخلاقه جميلة، تجربة رائعة جدا",
      "source_ref": "r6"
    },
    {
      "author": "أصايل",
      "stars": 5,
      "text": "مقهى يقع على الزاوية يتميز بإطلالته على المنطقة المحيطة من اي جلسة خارجية أو على جانبي النوافذ في المقهى. يطل على ساحة باريس… جربنا لديهم البان كيك… التراميسيو..حلاها موزون وخفيفة",
      "source_ref": "r8"
    },
    {
      "author": "طارق ر.",
      "stars": 5,
      "text": "اجمل محل في عمان ارجيلة لطيفه وخدمة ممتازة ومشروبات لذيذه وايضا الاطلاله جميله وموظفين رائعين انبسطنا كثير",
      "source_ref": "r9"
    },
    {
      "author": "Philip D.",
      "stars": 5,
      "text": "Nice little place to relax with shisha in the afternoon… the staff are friendly and welcoming.",
      "source_ref": "r1"
    }
