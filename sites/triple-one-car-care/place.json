  "reviews": [
    {
      "author": "Ibad R.",
      "stars": 5,
      "text": "I recently got PPF done from Triple One in Jeddah, and I’m extremely happy with the overall experience. The team was professional, knowledgeable, and paid great attention to detail throughout the process.",
      "source_ref": "Ci9DQUlRQUNvZENodHljRjlvT210S05FdFRTSGt0YlhKUk0ySktORU5DYWtwb01VRRAB"
    },
    {
      "author": "Khalid M.",
      "stars": 5,
      "text": "You cannot even tell that the car has PPF. There are no visible plastics on the edges. Its all hidden. I recommend Triple One.",
      "source_ref": "Ci9DQUlRQUNvZENodHljRjlvT2xKeE9EUXhZMjVTVERkUlJFNWFkR1JwWjBoeFdIYxAB"
    },
    {
      "author": "ehab k.",
      "stars": 5,
      "text": "Absolutely one of the best automotive services in town. They did full matte PPF, window shield, interior nano ceramic, nano ceramic for glass and rings, and body kit accessories. If you have a cool ride visit them and they will transform it even better",
      "source_ref": "ChZDSUhNMG9nS0VQWEg4SnZwdVl6MlN3EAE"
    },
    {
      "author": "Jasica A.",
      "stars": 5,
      "text": "TRIPLE ONE is truly one of the best car care shops! Their washing, polishing, detailing and sticker work are always top quality. The staff is professional and friendly, and they take care of every car as if it’s their own.",
      "source_ref": "Ci9DQUlRQUNvZENodHljRjlvT21WalpVcEhhRXRTV1VsdlIxcFlWRWRNZUdkcGIzYxAB"
    },
    {
      "author": "Rayyan",
      "stars": 5,
      "text": "Highly Recommended! The staff is extremely professional and skilled. Reasonable prices and high quality.",
      "source_ref": "Ci9DQUlRQUNvZENodHljRjlvT21Vd05sUlRkbk5JUkhoZmMwdGlkbEpMUTNRMU4yYxAB"
    }
